@model IEnumerable<TP6.Models.Cliente>

@{
    ViewData["Title"] = "Listado de Clientes";
}

<h1>Listado de Clientes</h1>

<table class="table table-striped table-dark table-bordered align-middle">
    <caption>Lista de Clientes</caption>
    <thead>
        <tr>
            <th scope="col">Id</th>
            <th scope="col">Nombre</th>
            <th scope="col">Email</th>
            <th scope="col">Teléfono</th>
            <th scope="col">Modificar</th>
            <th scope="col">Eliminar</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var cliente in Model)
        {
            <tr>
                <td>@cliente.IdCliente</td>
                <td>@cliente.Nombre</td>
                <td>@cliente.Email</td>
                <td>@cliente.Telefono</td>
                <td><a asp-controller="Cliente" asp-action="EditCliente" asp-route-idCliente="@cliente.IdCliente" class="btn btn-info">Modificar</a></td>
                <td><a asp-controller="Cliente" asp-action="DeleteCliente" asp-route-idCliente="@cliente.IdCliente" class="btn btn-danger">Borrar</a></td>
            </tr>
        }
    </tbody>
</table>

<a asp-controller="Cliente" asp-action="CreateCliente" class="btn btn-dark btn-lg">Alta de cliente</a>