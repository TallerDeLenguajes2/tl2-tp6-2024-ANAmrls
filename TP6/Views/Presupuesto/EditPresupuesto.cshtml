@model TP6.ViewModels.EditPresupuestoViewModel

@{
    ViewData["Title"] = "Modificar Presupuesto";
}

<h1>Alta de Presupuesto</h1>

<form asp-controller="Presupuesto" asp-action="EditPresupuesto" method="post">

    <div class="form-group mb-3">
        <label asp-for="FechaCreacion">Fecha de Creación</label>
        <input asp-for="FechaCreacion" type="datetime" value="@Model.FechaCreacion" class="form-control" readonly>
    </div>
    <div class="form-group mb-3">
        <label asp-for="IdCliente">Cliente</label>
        <select class="form-select mb-3" asp-for="IdCliente" asp-items="@Model.Options">
            <option selected>Seleccione un nuevo cliente</option>
        </select>
    </div>
    <input asp-for="IdPresupuesto" type="hidden" value="@Model.IdPresupuesto" />

    <div class="form-group mb-2">
        <button type="submit" class="btn btn-primary">Modificar</button>
    </div>
</form>
